# ============================================================
# REFERENCE ONLY — This file is NOT loaded by the application.
# All settings below are configured via environment variables
# or .env file. See .env.example for the actual configuration.
# This file documents available settings and their defaults.
# ============================================================

# ──────────────────────────────────────────────────────────────────
# gateway.yaml — Main server and Odoo connection configuration
# Copy to gateway.yaml and adjust for your environment.
# ──────────────────────────────────────────────────────────────────

server:
  name: "odoo-mcp-gateway"
  transport: stdio            # "stdio" or "streamable-http"
  host: 127.0.0.1             # bind address for streamable-http
  port: 8080                  # bind port for streamable-http
  log_level: INFO             # DEBUG, INFO, WARNING, ERROR
  max_concurrent_sessions: 100
  session_timeout_seconds: 1800

odoo:
  # WARNING: Use HTTPS in production. Plain HTTP exposes credentials and
  # session tokens to network eavesdropping. Only use HTTP for local dev.
  url: "http://localhost:8069"
  database: ""                # leave empty for single-db installs
  version: auto               # auto-detect, or pin to 17, 18, 19
  pool_size: 10               # HTTP connection pool size
  circuit_breaker:
    failure_threshold: 5      # consecutive failures before opening
    recovery_timeout_seconds: 30
  retry:
    max_retries: 3
    backoff_base_seconds: 1

auth:
  methods:
    - api_key
    - password
  required_group: ""          # e.g. "base.group_user" to restrict

  # OAuth 2.1 (ADR-005). Optional — set OAUTH_ENABLED=true to accept
  # IdP-issued JWTs alongside the gateway's own opaque login tokens.
  # When enabled, OAUTH_ISSUER and OAUTH_AUDIENCE are REQUIRED; the
  # gateway fails fast at startup if they're missing.
  oauth:
    enabled: false                                # MCP_OAUTH_ENABLED
    issuer: ""                                    # e.g. "https://keycloak.example.com/realms/odoo-mcp"
    audience: ""                                  # e.g. "https://mcp.example.com/"
    jwks_uri: ""                                  # optional; defaults to "<issuer>/.well-known/jwks.json"
    required_scopes: ""                           # comma-separated, e.g. "odoo.read,odoo.write"

rate_limit:
  global_per_minute: 60
  write_per_minute: 20

# Reverse-proxy trust. SECURITY: only enable when the gateway is
# actually behind a trusted proxy that overwrites X-Forwarded-For.
# Otherwise any caller can forge XFF and trivially defeat per-IP
# rate limiting on the login tool.
http:
  trust_proxy: false                              # MCP_TRUST_PROXY

# /metrics auth. Secure-by-default ON: scrapes must present
# "Authorization: Bearer <metrics_token>". Operators behind a network
# ACL can opt out by setting MCP_METRICS_REQUIRE_AUTH=false.
# /health and /ready stay anonymous — they're load-balancer probes.
observability:
  metrics_require_auth: true                      # MCP_METRICS_REQUIRE_AUTH
  metrics_token: ""                               # MCP_METRICS_TOKEN (SecretStr)
