# ──────────────────────────────────────────────────────────────────
# rbac.yaml — Role-based access control overlays
# Maps MCP tool operations to required Odoo groups.
# Copy to rbac.yaml and customise for your deployment.
# ──────────────────────────────────────────────────────────────────

# Which Odoo groups are required to call specific MCP tools.
# Users without the listed group will get a permission-denied error.
#
# Domain-plugin tools (HR / Sales / Project / Helpdesk) require the
# *base user* group of that domain by default — adjust per-tool if you
# want managers-only access. The manager groups can call everything a
# regular user can plus the manager-only entries below.
tool_group_requirements:
  delete_record:
    - base.group_system                  # only admins can delete
  execute_method:
    - base.group_system                  # arbitrary method calls = admin
  update_record:
    - base.group_user                    # any internal user
  create_record:
    - base.group_user

  # ── Sales ──────────────────────────────────────────────────────
  get_my_quotations:
    - sales_team.group_sale_salesman
    - sales_team.group_sale_manager
  get_order_details:
    - sales_team.group_sale_salesman
    - sales_team.group_sale_manager
  confirm_order:
    - sales_team.group_sale_salesman
    - sales_team.group_sale_manager
  get_sales_summary:
    - sales_team.group_sale_salesman_all_leads
    - sales_team.group_sale_manager

  # ── Project ────────────────────────────────────────────────────
  get_my_tasks:
    - project.group_project_user
    - project.group_project_manager
  update_task_stage:
    - project.group_project_user
    - project.group_project_manager
  get_project_summary:
    - project.group_project_user
    - project.group_project_manager

  # ── Helpdesk ───────────────────────────────────────────────────
  get_my_tickets:
    - helpdesk.group_helpdesk_user
    - helpdesk.group_helpdesk_manager
  create_ticket:
    - helpdesk.group_helpdesk_user
    - helpdesk.group_helpdesk_manager
  update_ticket_stage:
    - helpdesk.group_helpdesk_user
    - helpdesk.group_helpdesk_manager

  # ── HR ─────────────────────────────────────────────────────────
  get_my_profile:
    - base.group_user                    # any logged-in internal user
  get_my_attendance:
    - base.group_user
  check_in:
    - base.group_user
  check_out:
    - base.group_user
  get_my_leaves:
    - base.group_user
  request_leave:
    - base.group_user

  # ── Accounting (uncomment if you publish accounting tools) ─────
  # get_my_invoices:
  #   - account.group_account_invoice
  #   - account.group_account_manager

# Fields that are redacted (replaced with "***") for users who lack
# the specified group.  This runs AFTER Odoo's own field ACLs.
sensitive_fields:
  hr.employee:
    fields:
      - wage
      - salary
      - ssnid
      - bank_account_id
      - private_email
      - private_phone
      - identification_id
    required_group: hr.group_hr_manager

  res.users:
    fields:
      - password
      - signup_token
      - groups_id
    required_group: base.group_system

# Per-model field-level group overrides.  Even if a user can read the
# model, these fields require the specified group to be visible.
field_group_overrides:
  account.move:
    amount_total:
      read: account.group_account_invoice
      write: account.group_account_manager
    amount_residual:
      read: account.group_account_invoice
      write: account.group_account_manager

  sale.order:
    margin:
      read: sale.group_sale_manager
      write: sale.group_sale_manager

  purchase.order:
    amount_total:
      read: purchase.group_purchase_user
      write: purchase.group_purchase_manager

  hr.employee:
    wage:
      read: hr.group_hr_manager
      write: hr.group_hr_manager
    salary:
      read: hr.group_hr_manager
      write: hr.group_hr_manager
